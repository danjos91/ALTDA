# Copy to .env (gitignored). Leave OPENAI_API_KEY empty for Go stub mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: force stub even when a key is set
# ALTDA_STUB=true

# Bounded per-module concurrency for POST /v1/content (default 4)
# ALTDA_CONTENT_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Before the demo: switch OPENAI_* to your OpenAI-compatible gateway.
# Official docs (verified):
#   Cloud.ru Foundation Models quickstart:
#     https://cloud.ru/docs/foundation-models/ug/topics/quickstart
#   GigaChat OpenAI compatibility:
#     https://developers.sber.ru/docs/ru/gigachat/guides/compatible-openai
# ---------------------------------------------------------------------------

# Cloud.ru Foundation Models (OpenAI-compatible)
# OPENAI_BASE_URL=https://foundation-models.api.cloud.ru/v1
# OPENAI_MODEL=ai-sage/GigaChat3-10B-A1.8B
# OPENAI_API_KEY=<foundation-models-api-key>

# GigaChat via OpenAI SDK (access token as api_key; token TTL ~30 min)
# OPENAI_BASE_URL=https://api.giga.chat/v1
# OPENAI_MODEL=GigaChat
# OPENAI_API_KEY=<gigachat-access-token>
