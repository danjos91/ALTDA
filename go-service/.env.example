HOST=0.0.0.0
HTTP_PORT=8081
ENV=local
LOG_LEVEL=debug

# Leave OPENAI_API_KEY empty (or set ALTDA_STUB=true) for template stub mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=GigaChat/GigaChat-3-Pro

# Optional: force stub even when a key is set
# ALTDA_STUB=true

# Process-wide LLM concurrency (default 2). Content parallelism cannot exceed this.
# ALTDA_LLM_CONCURRENCY=2
# ALTDA_CONTENT_CONCURRENCY=2

# Per-call LLM timeout (seconds), max_tokens (≥1000), endpoint deadlines, HTTP WriteTimeout.
# ALTDA_LLM_CALL_TIMEOUT_SEC=110
# ALTDA_LLM_MAX_TOKENS=4096
# ALTDA_SKELETON_DEADLINE_SEC=280
# ALTDA_CONTENT_DEADLINE_SEC=870
# ALTDA_HTTP_WRITE_TIMEOUT_MIN=16

# ---------------------------------------------------------------------------
# On the hackathon VM keys live in /opt/hackathon/ai.env:
#   set -a; source /opt/hackathon/ai.env; set +a
# Or point compose env_file at that path (see deploy/docker-compose.yml).
# ---------------------------------------------------------------------------

# Cloud.ru Foundation Models (OpenAI-compatible)
# OPENAI_BASE_URL=https://foundation-models.api.cloud.ru/v1
# OPENAI_MODEL=ai-sage/GigaChat3-10B-A1.8B
# OPENAI_API_KEY=<foundation-models-api-key>

# GigaChat via OpenAI SDK (access token as api_key; token TTL ~30 min)
# OPENAI_BASE_URL=https://api.giga.chat/v1
# OPENAI_MODEL=GigaChat
# OPENAI_API_KEY=<gigachat-access-token>
