# Copy to deploy/.env (or use ../.env / /opt/hackathon/ai.env). No real keys in git.

# Host ports
JAVA_PORT=8000
GO_PORT=8081

# What Java talks to: http (Go service) or mock (Java built-in stand-in)
ALTDA_GO_CLIENT=http
# GO_BASE_URL=http://go:8081

# Stub mode for compose/smoke without the gateway (default when key empty)
ALTDA_STUB=true
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=GigaChat/GigaChat-3-Pro
ALTDA_LLM_CONCURRENCY=2
ALTDA_CONTENT_CONCURRENCY=2

# On the hackathon VM:
#   set -a; source /opt/hackathon/ai.env; set +a
#   # then unset ALTDA_STUB and docker compose up
# Or set compose env_file to /opt/hackathon/ai.env (see docker-compose.yml comments).

# Cloud.ru Foundation Models (OpenAI-compatible)
# OPENAI_BASE_URL=https://foundation-models.api.cloud.ru/v1
# OPENAI_MODEL=ai-sage/GigaChat3-10B-A1.8B
# OPENAI_API_KEY=<foundation-models-api-key>

# GigaChat via OpenAI SDK
# OPENAI_BASE_URL=https://api.giga.chat/v1
# OPENAI_MODEL=GigaChat
# OPENAI_API_KEY=<gigachat-access-token>
