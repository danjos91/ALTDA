# Copy to .env and adjust. Docker Compose reads it from this folder.

# Host ports
JAVA_PORT=8000
GO_PORT=8081

# What Java talks to: http (our Go service) or mock (Java's built-in stand-in)
ALTDA_GO_CLIENT=http

# Only with http. The default is the go service of this compose.
# GO_BASE_URL=http://go:8081
# A Go running on your machine instead:
# GO_BASE_URL=http://host.docker.internal:8081
