# Copy to deploy/.env (or export vars from the shell). No real keys in git.

# Host ports
JAVA_PORT=8000
GO_PORT=8081

# What Java talks to: http (Go service) or mock (Java built-in stand-in)
ALTDA_GO_CLIENT=http
# GO_BASE_URL=http://go:8081

# Leave empty: an empty OPENAI_API_KEY already enables stub mode.
# Set ALTDA_STUB=true only to force stub while a key is present.
ALTDA_STUB=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=GigaChat/GigaChat-3-Pro
ALTDA_LLM_CONCURRENCY=2
ALTDA_CONTENT_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Prefer, in order:
#   1) Hackathon gateway — source /opt/hackathon/ai.env (OPENAI_API_KEY, OPENAI_BASE_URL)
#   2) Cloud.ru Foundation Models key (OpenAI-compatible)
# GigaChat access tokens expire in ~30 minutes; use them only for short demos.
# ---------------------------------------------------------------------------

# On the hackathon VM (real LLM):
#   set -a; source /opt/hackathon/ai.env; set +a
#   cd deploy && docker compose -p altda up --build -d
# Stub (no gateway): leave OPENAI_API_KEY empty and compose up.

# Cloud.ru Foundation Models (OpenAI-compatible)
# OPENAI_BASE_URL=https://foundation-models.api.cloud.ru/v1
# OPENAI_MODEL=ai-sage/GigaChat3-10B-A1.8B
# OPENAI_API_KEY=<foundation-models-api-key>

# GigaChat via OpenAI SDK (access token TTL ~30 min — prefer hackathon/Cloud.ru)
# OPENAI_BASE_URL=https://api.giga.chat/v1
# OPENAI_MODEL=GigaChat
# OPENAI_API_KEY=<gigachat-access-token>
